{
  "name": "@neovici/cosmoz-tree-view",
  "version": "0.0.0",
  "description": "Tree view web component: nested, expandable, virtualized rows (Untitled UI tree view)",
  "keywords": [
    "web-components",
    "pion",
    "lit-html",
    "tree",
    "treeview"
  ],
  "homepage": "https://github.com/Neovici/cosmoz-tree-view#readme",
  "bugs": {
    "url": "https://github.com/Neovici/cosmoz-tree-view/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neovici/cosmoz-tree-view.git"
  },
  "license": "Apache-2.0",
  "author": "Neovici Development",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "lint": "tsc && eslint --cache .",
    "check:duplicates": "check-duplicate-components",
    "build": "tsc -p tsconfig.build.json",
    "changeset": "changeset",
    "start": "wds",
    "test": "vitest --run",
    "test:unit": "vitest --project=unit --run",
    "test:storybook": "vitest --project=storybook --run",
    "test:watch": "vitest",
    "storybook:start": "storybook dev -p 8000",
    "storybook:build": "storybook build",
    "storybook:deploy": "storybook-to-ghpages",
    "storybook:preview": "npm run storybook:build && http-server ./storybook-static/ --silent",
    "prepare": "husky"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "types"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cosmoz-tree-view": {
      "types": "./dist/cosmoz-tree-view.d.ts",
      "default": "./dist/cosmoz-tree-view.js"
    },
    "./flatten": {
      "types": "./dist/flatten.d.ts",
      "default": "./dist/flatten.js"
    }
  },
  "dependencies": {
    "@lit-labs/virtualizer": "^2.1.1",
    "@neovici/cosmoz-icons": "^1.6.0",
    "@neovici/cosmoz-tokens": "^3.2.1 || ^4.0.0",
    "@neovici/cosmoz-utils": "^6.23.0",
    "@pionjs/pion": "^2.5.2",
    "lit-html": "^3.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@neovici/cfg": "^2.15.0",
    "@neovici/testing": "^2.3.0",
    "@playwright/test": "1.60.0",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/addon-vitest": "^10.2.4",
    "@storybook/web-components-vite": "^10.2.4",
    "@types/node": "^26.6.2",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "eslint": "^9.0.0",
    "http-server": "^14.1.1",
    "husky": "^9.0.0",
    "jsdom": "^29.0.1",
    "lint-staged": "^17.0.7",
    "remark-gfm": "^4.0.1",
    "shadow-dom-testing-library": "^1.13.1",
    "sinon": "^22.0.0",
    "storybook": "^10.0.0",
    "typescript": "^5.4.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "conventional-changelog-conventionalcommits": ">= 8.0.0"
  }
}
